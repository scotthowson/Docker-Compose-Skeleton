# Environment configuration (contains secrets)
.env

# Keep the example template
!.env.example

# Stack .env files contain deployed secrets (CF tokens, passwords) — do NOT track
# They are auto-generated during template deployment
Stacks/*/.env

# API auth data (tokens, sessions, deploy history)
.api-auth/

# Compose history snapshots
.compose-history/

# Logs
logs/
*.log

# Backup files from deploy/undeploy operations
*.bak
*.bak.*

# Persistent container data
App-Data/

# IDE files
.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
