#!/bin/bash
# compose-linter — pre-deploy hook
# Validates compose content before deployment
CONTEXT=$(cat)
COMPOSE=$(echo "$CONTEXT" | jq -r '.compose // empty' 2>/dev/null)
STACK=$(echo "$CONTEXT" | jq -r '.stack // "unknown"' 2>/dev/null)
TEMPLATE=$(echo "$CONTEXT" | jq -r '.template // "unknown"' 2>/dev/null)
if [[ -z "$COMPOSE" ]]; then
    echo "{\"plugin\":\"compose-linter\",\"status\":\"skip\",\"message\":\"No compose content to lint\"}"
    exit 0
fi
WARN_COUNT=0
WARNINGS=""
SERVICES=$(echo "$COMPOSE" | grep -E "^  [a-zA-Z_-][a-zA-Z0-9_-]*:" | sed "s/^  //;s/://")
for SVC in $SERVICES; do
    BLOCK=$(echo "$COMPOSE" | sed -n "/^  ${SVC}:/,/^  [a-zA-Z_-]/p")
    if ! echo "$BLOCK" | grep -q "restart:"; then
        WARN_COUNT=$((WARN_COUNT+1))
        [[ -n "$WARNINGS" ]] && WARNINGS+=","
        WARNINGS+="{\"service\":\"$SVC\",\"rule\":\"missing-restart\",\"message\":\"No restart policy\",\"severity\":\"warning\"}"
    fi
    if echo "$BLOCK" | grep -q "privileged:[[:space:]]*true"; then
        WARN_COUNT=$((WARN_COUNT+1))
        [[ -n "$WARNINGS" ]] && WARNINGS+=","
        WARNINGS+="{\"service\":\"$SVC\",\"rule\":\"privileged\",\"message\":\"Privileged mode enabled\",\"severity\":\"warning\"}"
    fi
    if ! echo "$BLOCK" | grep -q "healthcheck:"; then
        WARN_COUNT=$((WARN_COUNT+1))
        [[ -n "$WARNINGS" ]] && WARNINGS+=","
        WARNINGS+="{\"service\":\"$SVC\",\"rule\":\"missing-healthcheck\",\"message\":\"No health check\",\"severity\":\"info\"}"
    fi
done
if [[ $WARN_COUNT -eq 0 ]]; then
    echo "{\"plugin\":\"compose-linter\",\"status\":\"pass\",\"stack\":\"$STACK\",\"template\":\"$TEMPLATE\",\"warnings\":[],\"message\":\"All checks passed\"}"
else
    echo "{\"plugin\":\"compose-linter\",\"status\":\"warn\",\"stack\":\"$STACK\",\"template\":\"$TEMPLATE\",\"warning_count\":$WARN_COUNT,\"warnings\":[$WARNINGS],\"message\":\"$WARN_COUNT issue(s) found\"}"
fi
exit 0